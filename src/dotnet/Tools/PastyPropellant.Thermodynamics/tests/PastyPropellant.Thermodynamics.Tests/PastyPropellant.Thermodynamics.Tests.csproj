<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-linked (not referenced) for the same reason the Tools libraries link it:
         the type is internal so each assembly gets its own copy and they cannot collide.
         The tests need it to locate the repository root instead of guessing with a
         relative path, which the centralised artifacts/ output layout invalidated. -->
    <Compile Include="../../../../Shared/PythonRuntime.cs" Link="Shared/PythonRuntime.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PastyPropellant.Thermodynamics/PastyPropellant.Thermodynamics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
