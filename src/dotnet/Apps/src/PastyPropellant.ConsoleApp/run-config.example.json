{
  // EXAMPLE run configuration for the PastyPropellant console host. Not read by anything: copy it to
  // `run-config.json` in the directory you run from, or pass it with `--config <path>`.
  //
  // The file is OPTIONAL and PARTIAL. Every setting below already has a built-in default equal to the
  // value that used to be hardcoded in the host, so a run with no configuration file behaves exactly as
  // it did before this file existed. Delete any key you do not want to change; only what remains is
  // overridden. An unknown key, an unknown parameter name, or a value that would produce an invalid run
  // is a hard startup error, never a silent fallback.
  //
  // Paths (this file, the propellants file, every output) resolve against the PROCESS WORKING DIRECTORY.
  //
  // Whatever a run resolves is written to `run_configuration.resolved.json` next to the outputs and
  // summarised at the top of the PDF report — including the values derived at run time, such as the
  // worker count after the divisibility-reduction rule. That record is what makes a run traceable now
  // that changing an experiment no longer requires a recompile.

  "inputFileName": "propellants.01234.json",

  // The 18 physical parameters, by name. Any parameter you omit keeps its default bound, and the two
  // sides are independent — naming only `upper.ADecompose` leaves `lower.ADecompose` alone.
  "bounds": {
    "lower": {
      "ADecompose": 1.0,
      "EDecompose": 5e4,
      "AKineticFlameInterPocket": 1e5,
      "EKineticFlameInterPocket": 5e4,
      "AKineticFlamePocketOutSkeleton": 1e5,
      "EKineticFlamePocketOutSkeleton": 5e4,
      "AKineticFlamePocketSkeleton": 1e5,
      "EKineticFlamePocketSkeleton": 5e4,
      "NuInterPocket": 0.0,
      "NuPocketOutSkeleton": 0.0,
      "NuPocketSkeleton": 0.0,
      "AMetalBurningConstant": 1e-10,
      "BMetalBurningConstant": 1e-12,
      "DeltaH": -1e7,
      "KDiffusionHeight": 1e-3,
      "APowOrder": 0.0,
      "BPowOrder": 0.0,
      "KCoefficientRadiationTemperature": 0.0
    },
    "upper": {
      "ADecompose": 1e13,
      "EDecompose": 3e5,
      "AKineticFlameInterPocket": 1e13,
      "EKineticFlameInterPocket": 2.5e5,
      "AKineticFlamePocketOutSkeleton": 1e13,
      "EKineticFlamePocketOutSkeleton": 2.5e5,
      "AKineticFlamePocketSkeleton": 1e13,
      "EKineticFlamePocketSkeleton": 2.5e5,
      "NuInterPocket": 2.5,
      "NuPocketOutSkeleton": 2.5,
      "NuPocketSkeleton": 2.5,
      "AMetalBurningConstant": 1e-3,
      "BMetalBurningConstant": 1e-5,
      "DeltaH": 1e7,
      "KDiffusionHeight": 1e1,
      "APowOrder": 3.0,
      "BPowOrder": 3.0,
      "KCoefficientRadiationTemperature": 1.0
    }
  },

  // Thresholds of the five constraint-penalty evaluators. These are part of the score, so they apply to
  // `--forward-eval` replays too: a vector replayed under different thresholds is a different number.
  "penalties": {
    "penaltyRate": 0.01,
    "heatFluxRatioThreshold": 100.0,
    "poreDiameterThreshold": 3.0,
    "largeOxidizerParticleSizeThreshold": 1.0,
    "maxInterPocketKineticFlameHeatFluxWattsPerSquareMeter": 1e9,
    "maxSkeletonKineticFlameHeatFluxWattsPerSquareMeter": 1e8,
    "maxOutSkeletonKineticFlameHeatFluxWattsPerSquareMeter": 1e8
  },

  // Physical constants of the model: not fitted, not per-propellant, but they change every computed
  // number. They live here rather than in source so that every run records which values produced it —
  // before this section existed, a whole campaign at 2300 K left no trace of that in any report.
  "model": {
    // Melting temperature of the aluminium skeleton. Default 1300 K.
    "metalMeltingTemperatureKelvins": 1300.0,

    // Bracket the condensed-phase solve bisects the surface temperature in. Default 600..900 K.
    // NOT a handbook constant - a deliberate experimental setting that acts as a SOFT CONSTRAINT: the
    // solve reports failure when no root lies inside, so a composition sitting on a bound is not a
    // solution the physics chose, it is one the bracket imposed. Moving a bound can also move the search
    // onto a different root. The published line of work used 600..750 K.
    "minSurfaceTemperatureKelvins": 600.0,
    "maxSurfaceTemperatureKelvins": 900.0,

    // How f_s, the share of the pocket surface carrying a skeleton layer, is obtained.
    //
    //   "Polynomial" (default, historical) - the per-propellant fit shipped in propellants*.json.
    //       22 coefficients across the five compositions, none of which transfers to a composition that
    //       was not measured, and four of which go negative or turn upward outside 1..6.5 MPa.
    //
    //   "EquilibriumCarbon" - the skeleton is the pocket's aluminium held together by the carbonaceous
    //       residue of binder pyrolysis. f_s is an AREA fraction, and Delesse's theorem equates that to
    //       the volume fraction, so it is the share of the pocket still solid at the surface:
    //
    //           f_s(p, T_s) = phi_Al + phi_C(s)(T_pore, p) ,  T_pore = (T_s + T_m) / 2
    //
    //       C(s) + 2H2 -> CH4 is the only carbon sink here that runs with a DECREASE in mole number,
    //       hence the only one pressure drives forward; Boudouard and steam gasification both go with
    //       dn = +1 and are suppressed by pressure. That is why coverage falls with pressure at all.
    //
    //       ZERO fitted numbers, NO SCALE FACTOR (Delesse fixes the mapping) and no agglomeration data:
    //       phi_Al is recipe, phi_C(s) is a Gibbs minimisation over the pocket matrix (binder +
    //       aluminium + fine AP, from the recipe), and T_s is the model's own surface temperature.
    //       Coverage is therefore evaluated INSIDE the surface-temperature bisection, not per pressure.
    //
    // NOT A TUNING KNOB: f_s weighs (q_metal + q_k^S)
    // against q_k^OS and appears nowhere else, so a coverage the optimiser could choose would be
    // algebraically the same as redistributing between the skeleton and out-skeleton kinetic-flame
    // pre-exponentials. There is deliberately nothing here for the search to move.
    "skeletonSurfaceFraction": {
      "mode": "Polynomial",

      // Read only when mode is EquilibriumCarbon; resolved against the process working directory.
      // DERIVED DATA, not configuration: regenerate it whenever the propellants file changes, with
      //     python generate_skeleton_carbon_equilibrium.py
      // A missing or malformed table is a hard startup error, never a silent fallback to the polynomial.
      "equilibriumTableFile": "skeleton_carbon_equilibrium.json",

      // mode = KineticCoverage: coverage as the steady state of a rate competition —
      //
      //           f_s = 1 / (1 + a0 + a1 * w_fine * (p / p_ref)^m)
      //
      //       w_fine is the FINE ammonium perchlorate mass fraction, the oxidiser that lies inside the
      //       pocket (the coarse fraction is the wall). a0 is burnout of the skeleton's binder residue by
      //       the binder's own decomposition products — the binder is itself a perchlorate, so this
      //       channel exists with no AP in the pocket at all, and it carries no pressure dependence.
      //       a1 * w_fine * p^m is burnout by the fine AP.
      //
      //       Writing both rates per unit skeleton area makes the layer thickness cancel identically, so
      //       this closure is independent of the fitted delta.
      //
      //       THESE THREE CONSTANTS ARE CALIBRATED, NOT DERIVED. They were fitted on Bas_2/Bas_3/Bas_4 —
      //       one binder, the same 0.5 % activated carbon, differing only in AP dispersity — giving
      //       4.7-8.6 % RMS on f_s in-sample and 12.7-20.9 % when one composition is left out of the fit
      //       and predicted. They do NOT describe Bas_0 or Bas_1, which carry a different binder; the
      //       same constants overshoot those two by 13-137 %. Do not quote a Bas_0/Bas_1 number from a
      //       run under this closure.
      "kinetic": {
        "binderChannel": 0.9966,
        "fineOxidiserChannel": 3.3653,
        "pressureOrder": 0.71,
        // A unit choice, not a physical constant: moving it rescales fineOxidiserChannel.
        "referencePressurePascals": 1000000.0
      }
    }
  },

  "differentialEvolution": {
    // Classic | Jde | Jade | Shade | LShade. Only the sub-section matching the selected strategy is
    // read, but both are validated, so a broken setting cannot lie dormant until someone switches.
    "strategy": "Jde",
    // F and CR are consumed only by Classic and Jde; the adaptive variants self-tune them.
    "mutationForce": 0.5,
    "crossoverProbability": 0.9,
    "safetyTimeoutHours": 9.0,
    // Fixed RNG seed. Omit (or null) to leave the search unseeded, which is the historical behaviour.
    // Set it and the run is bit-for-bit repeatable — but only at the SAME worker count, because the
    // library derives one random stream per worker. The effective worker count is machine-dependent
    // (ProcessorCount - 1, reduced until it divides the population), so a seed alone does not identify
    // a run: run_configuration.resolved.json records the seed and the worker count together.
    // "seed": 20260729,

    // Classic / Jde / Jade / Shade: fixed population, stagnation-driven termination.
    "fixedPopulation": {
      // Population = 32 (the group vector length) x this multiplier. 32 x 12 = 384.
      "populationSizeMultiplier": 12,
      // Worker count starts at (machine cores - 1) and walks down while it does not divide the
      // population evenly, stopping here. Lower it on a machine with few cores.
      "minProcessorsCount": 14,
      "maxStagnationStreak": 5000,
      "relativeStagnationThreshold": 1e-6
    },

    // LShade only: budget-driven, with a population that shrinks linearly across the budget.
    "lShade": {
      "populationSizeMultiplier": 18,
      "maxEvaluationNumber": 5000000,
      "pBestRate": 0.11,
      "archiveSizeRate": 2.6,
      "memorySize": 6
    }
  },

  // Local refinement layered on the DE search. The final polish is guarded: it can only improve on the
  // DE best, never replace it with something worse.
  "nelderMead": {
    "enabled": true,
    "memeticInLoop": false,
    "everyNGenerations": 50,
    "memeticMaxEvaluationsPerCall": 200,
    "finalPolish": true,
    "finalPolishMaxEvaluations": 100000,
    "adaptiveCoefficients": true,
    "domainTolerance": 1e-8,
    "functionTolerance": 1e-8,
    "restarts": 2
  }
}
