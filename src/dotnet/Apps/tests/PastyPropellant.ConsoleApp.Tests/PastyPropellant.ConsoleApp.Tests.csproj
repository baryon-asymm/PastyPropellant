<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-linked, not referenced: PythonRuntime is internal, so the copy inside
         the ConsoleApp assembly is not visible here. The tests need its repo-root
         resolver to locate scripts and data, which the centralised artifacts/ output
         layout broke for the old relative paths. -->
    <Compile Include="..\..\..\Shared\PythonRuntime.cs" Link="Shared\PythonRuntime.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PastyPropellant.ConsoleApp\PastyPropellant.ConsoleApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
